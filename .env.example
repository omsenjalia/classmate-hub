# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GitHub storage (keep this token server-only; never prefix it with NEXT_PUBLIC_)
STORAGE_GITHUB_TOKEN=github_fine_grained_token_here
STORAGE_GITHUB_OWNER=your-github-owner
STORAGE_GITHUB_REPO=classmate-hub-storage
STORAGE_GITHUB_BRANCH=main

NEXT_PUBLIC_SITE_URL=http://localhost:3000
