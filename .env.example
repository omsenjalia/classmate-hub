# Supabase Configuration (Supports both new and standard naming conventions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Alternative standard Next.js naming convention
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 direct uploads. The browser uploads directly to the presigned
# URL, so large files never pass through a Vercel function.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=classmate-hub-materials
NEXT_PUBLIC_R2_PUBLIC_URL=https://files.example.com

# Configure this in the R2 bucket's CORS policy for local development and the
# deployed app: allow PUT, the Content-Type header, and both application origins.
# Do not expose R2_ACCESS_KEY_ID or R2_SECRET_ACCESS_KEY with NEXT_PUBLIC_.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
