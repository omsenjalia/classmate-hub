# Supabase Configuration (Supports both new and standard naming conventions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Alternative standard Next.js naming convention
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Private GitHub Repository Storage Engine (100% Free, >99MB Chunking Support)
STORAGE_GITHUB_TOKEN=ghp_your_personal_access_token_here
STORAGE_GITHUB_OWNER=omsenjalia
STORAGE_GITHUB_REPO=classmate-hub-storage
STORAGE_GITHUB_BRANCH=main

NEXT_PUBLIC_SITE_URL=http://localhost:3000
